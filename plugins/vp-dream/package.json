  "type": "module",
  "description": "vp-dream plugin — Claude Code file-based auto-memory consolidation.",
  "devDependencies": {
    "npm-run-all2": "^7.0.0",
    "remark-cli": "^12.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-lint-unordered-list-marker-style": "^4.0.1",
    "remark-preset-lint-consistent": "^6.0.0",
    "remark-preset-lint-recommended": "^7.0.0",
