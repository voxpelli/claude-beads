{
  "name": "diarie",
  "version": "0.0.0",
  "private": true,
  "description": "A flat-YAML task tracker that is just files. No daemon, no database, no git hooks.",
  "author": "Pelle Wessman <pelle@kodfabrik.se> (https://kodfabrik.se/)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "bin": {
    "diarie": "cli.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./schema": "./lib/schema.js"
  },
  "files": [
    "cli.js",
    "lib/**/*.js"
  ],
  "scripts": {
    "check": "run-p check:*",
    "check:ast-grep": "ast-grep scan",
    "check:ast-grep-test": "ast-grep test",
    "check:knip": "knip",
    "check:lint": "eslint",
    "check:tsc": "tsc",
    "check:type-coverage": "type-coverage --detail --strict --at-least 98 --ignore-files 'test/*'",
    "test": "node --test"
  },
  "dependencies": {
    "@voxpelli/typed-utils": "^5.0.0",
    "js-yaml": "^4.1.0",
    "peowly": "^1.3.3",
    "peowly-commands": "^1.1.0",
    "pony-cause": "^2.1.11"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@voxpelli/eslint-config": "^25.1.0",
    "@voxpelli/tsconfig": "^16.2.1",
    "eslint": "^9.39.4",
    "knip": "^5.88.1",
    "npm-run-all2": "^7.0.2",
    "type-coverage": "^2.29.7",
    "typescript": "~5.9.3"
  }
}
