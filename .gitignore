.DS_Store

# Ephemeral agent/sprint scratch artifacts (durable record lives in .diarie/tasks/)
AGENT-*.md
RETRO-*.md
SWARM-*.md
SPIKE-*.md

# Local plugin/registry overrides
.claude/*.local.*
.claude/synergy-registry.local.json
.claude/vendor-registry.local.json

# Private SYNERGY overlays (proprietary↔public boundary). The PRIVATE- prefix
# keeps them OUTSIDE the public `SYNERGY-*.md` glob namespace, so no consumer
# can ever accidentally read them. Never commit: holds entries deliberately
# kept out of the public repo.
PRIVATE-SYNERGY-*.md

node_modules/

# Beads — fully local, ephemeral working state (not shared via git)
.beads/

# NOTE: the `.diarie/` tracker dir is dotted but COMMITTED, not ephemeral — it is
# the live task store (`diarie`), deliberately git-tracked and PR-reviewed. Unlike
# `.beads/` above it is NOT ignored; the dot marks committed project metadata (cf.
# `.claude/`, `.github/`), not throwaway state. Do not add it here.

# SQLite transient sidecars — WAL/SHM are runtime state, never content.
# They were committed, which meant they also shipped into every consumer plugin cache.
.liggare/ledger.sqlite-wal
.liggare/ledger.sqlite-shm
