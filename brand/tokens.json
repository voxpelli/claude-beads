{
  "$description": "diarie design tokens — W3C Design Tokens Community Group draft format. Generated to mirror tokens.css; if the two disagree, tokens.css wins.",
  "palette": {
    "$description": "Raw named colors. Swedish names, ASCII-folded; glossary in BRAND.md.",
    "arkiv":          { "$type": "color", "$value": "#171126", "$description": "The archive after closing. Page ground." },
    "yta":            { "$type": "color", "$value": "#1F1733", "$description": "Raised surface on dark ground." },
    "yta-2":          { "$type": "color", "$value": "#2A1F45", "$description": "Higher surface: code, terminals." },
    "lysning-1":      { "$type": "color", "$value": "#221940", "$description": "Genomlysning halo, outermost step." },
    "lysning-2":      { "$type": "color", "$value": "#2E2257" },
    "lysning-3":      { "$type": "color", "$value": "#3C2D6E" },
    "lysning-4":      { "$type": "color", "$value": "#4B3A87", "$description": "Genomlysning halo, innermost step." },
    "papper":         { "$type": "color", "$value": "#EFE6D2", "$description": "Herbarium sheet. 14.78:1 on arkiv." },
    "hektograf":      { "$type": "color", "$value": "#6B4FC8", "$description": "Copy-ink violet. Large type/borders on arkiv (3.13:1); body text on papper (4.73:1)." },
    "hektograf-ljus": { "$type": "color", "$value": "#9C90C4", "$description": "Muted text on dark. 6.29:1 on arkiv." },
    "lavendel":       { "$type": "color", "$value": "#B7ABDD", "$description": "Secondary text on dark. 8.63:1 on arkiv." },
    "fosfor":         { "$type": "color", "$value": "#5CE49A", "$description": "Terminal phosphor. 11.37:1 on arkiv." },
    "barnsten":       { "$type": "color", "$value": "#E8A13C", "$description": "Amber (bärnsten). 8.38:1 on arkiv." },
    "stampel":        { "$type": "color", "$value": "#D8453E", "$description": "Stamp-pad red (stämpel). Large type and stamps on arkiv only (4.23:1)." },
    "stampel-ljus":   { "$type": "color", "$value": "#E8756B", "$description": "Red at body size on dark. 6.28:1 on arkiv." },
    "stampel-mork":   { "$type": "color", "$value": "#A83732", "$description": "Red at body size on papper. 5.19:1." }
  },
  "semantic": {
    "$description": "The CLI contract, in color.",
    "exit": {
      "0": { "$type": "color", "$value": "{palette.fosfor}",   "$description": "The answer is on stdout." },
      "1": { "$type": "color", "$value": "{palette.barnsten}", "$description": "You asked wrong: ENOSTORE, EUSAGE, EEXIST." },
      "2": { "$type": "color", "$value": "{palette.stampel}",  "$description": "It ran, and the answer is no. The stamp belongs to validate." }
    },
    "status": {
      "ready":     { "$type": "color", "$value": "{palette.fosfor}" },
      "blocked":   { "$type": "color", "$value": "{palette.lavendel}",     "$description": "Waiting, not wrong." },
      "attention": { "$type": "color", "$value": "{palette.stampel-ljus}", "$description": "Malformed, represented, never dropped." },
      "stale":     { "$type": "color", "$value": "{palette.barnsten}" }
    }
  },
  "type": {
    "$description": "Two voices, no third.",
    "arkiv":  { "$type": "fontFamily", "$value": ["Fraunces", "Georgia", "Times New Roman", "serif"], "$description": "The archive voice: what the human wrote." },
    "lasare": { "$type": "fontFamily", "$value": ["Fragment Mono", "ui-monospace", "SF Mono", "Menlo", "Consolas", "monospace"], "$description": "The reader voice: what the CLI reports." },
    "cuts": {
      "ordmarke": { "$value": { "opsz": 144, "wght": 520, "SOFT": 60, "WONK": 1 }, "$description": "The identity cut. Above ~40px only." },
      "rubrik":   { "$value": { "opsz": 72,  "wght": 480, "SOFT": 40, "WONK": 1 } },
      "brodtext": { "$value": { "opsz": 15,  "wght": 415, "SOFT": 0,  "WONK": 0 } }
    }
  },
  "shape": {
    "radie":    { "$type": "dimension", "$value": "6px" },
    "korn":     { "$type": "number", "$value": 0.04, "$description": "Riso grain opacity ceiling. Static, never animated." },
    "markering": { "$type": "color", "$value": "rgba(107, 79, 200, 0.32)", "$description": "The marker wash: hektograf at highlighter strength. At most three per page." },
    "hallinje": { "$type": "dimension", "$value": "0.5px" }
  },
  "motion": {
    "ease-lysning": { "$type": "cubicBezier", "$value": [0.22, 0, 0.18, 1], "$description": "The light coming up on the table. The only easing." },
    "dur-mikro":    { "$type": "duration", "$value": "180ms" },
    "dur-beat":     { "$type": "duration", "$value": "700ms" },
    "dur-reveal":   { "$type": "duration", "$value": "1100ms" }
  }
}
